{
  "manifest_version": 3,
  "name": "IntervQ",
  "short_name": "IntervQ",
  "version": "0.1.0",
  "description": "Ace every question. Tap to capture a question in your browser meeting and get a suggested answer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open IntervQ",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "tabCapture", "offscreen", "storage", "activeTab", "identity"],
  "host_permissions": [
    "https://us-central1-meeting-assist-c5249.cloudfunctions.net/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "commands": {
    "toggle-listen": {
      "suggested_key": {
        "default": "Alt+Shift+Q",
        "mac": "Alt+Shift+Q"
      },
      "description": "Start / stop listening for a question"
    }
  },
  "minimum_chrome_version": "116"
}
